# Copy to .env and change the passwords and secret. .env is never committed.

# Owner connection: runs migrations and demo data. Never used by the running app.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/nusuh
# Application connection: role nusuh_app, subject to row-level security.
DATABASE_URL=postgres://nusuh_app:change-me@localhost:5432/nusuh
# Password given to nusuh_app by `npm run db:migrate` (must match DATABASE_URL).
APP_DB_PASSWORD=change-me

# Web server
# production: the server refuses to start with unsafe settings (short or missing secrets, COOKIE_SECURE off, no https
# PUBLIC_URL, DEMO_LOGINS on, a database connection that is not nusuh_app). Anything else: the same list as warnings.
NODE_ENV=development
PORT=3000
# Use 0.0.0.0 to allow other devices on your network to connect.
HOST=127.0.0.1
# Signs the login cookie; at least 32 characters (required in production). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Encrypts two-factor and payment provider secrets stored in the database. At least 32 characters and different from
# SESSION_SECRET (required in production). Set once and keep it: changing it turns off everyone's two-factor.
ENCRYPTION_KEY=
# Public address used in links in emails (e.g. https://books.yourfirm.com). In production it is required, must start
# with https://, and is the only address used. Empty in development = the address in the browser.
PUBLIC_URL=
# Set to true when served over HTTPS (required in production).
COOKIE_SECURE=false
# Show one-click demo sign-in buttons. Development only: never with real client data (refused in production).
DEMO_LOGINS=true
# Behind your own reverse proxy (nginx, a load balancer): true, the number of proxy hops, or the proxy addresses
# (e.g. 10.0.0.0/8). The client address is then taken from X-Forwarded-For for sign-in throttling and logs.
# Leave false when the server is reached directly, or anyone could forge their address. In production it must be set
# (1 on most hosts, such as Render); the server refuses to start without it.
TRUST_PROXY=false

# Error reports: an https address that receives server errors, failed jobs and crashes as JSON (masked: no passwords,
# keys, tokens, one-time codes or amounts). Empty = off.
ERROR_REPORT_URL=
# Log detail: info (default), warn or error. Logs are masked the same way.
LOG_LEVEL=info

# Tests create and drop this database through the server at TEST_PG_ADMIN_URL.
TEST_PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
TEST_DB_NAME=nusuh_test

# Connecting a company to ZATCA's PRODUCTION (real tax invoices) is refused unless this is "on". Leave it out on demo and
# test sites; Sandbox and Simulation always work.
# ZATCA_PRODUCTION=on

# Demo mode (see render-demo.yaml). On the LIVE app: the demo site's https address and the secret shared with it (40+ random
# characters, the same value on both). Leave unset to hide the owner's Demo mode button. On the DEMO SITE only: DEMO_SITE=true
# (it then refuses to start unless OUTSIDE_CALLS=off, EMAIL_PROVIDER is unset, DEMO_LINK_SECRET is set, and its database is a
# demo database holding no real customer).
# DEMO_SITE_URL=https://your-demo-site.onrender.com
# DEMO_LINK_SECRET=
# DEMO_SITE=true

# --- Free trial: switches the owner sets in the host's settings (all off by default) ---
# TRIAL_EMAILS=on          sends the trial reminder e-mails and the alerts to hello@ (read the texts first)
# SIGNUP=on                opens self-service sign-up at /signup (needs PUBLIC_URL and SIGNUP_PEPPER)
# GOOGLE_CLIENT_ID=       'Continue with Google' on the sign-in and sign-up pages: the public Client ID from Google Cloud (ends .apps.googleusercontent.com). No secret is needed. Off when empty
# SIGNUP_PEPPER=           a long random secret (32+ characters) that keeps the record of who had a trial from being guessable; never change it later
# DOC_EXTRACT=on           lets customers have a PDF or picture read into import rows by an AI reader (needs ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=       the key for that reader; kept only in the host's settings
